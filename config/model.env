# Reference configuration for HauhauCS Gemma 4 E4B Aggressive GGUF.
MODEL_REPO=HauhauCS/Gemma-4-E4B-Uncensored-HauhauCS-Aggressive
MODEL_PREFIX=Gemma-4-E4B-Uncensored-HauhauCS-Aggressive
DEFAULT_QUANT=Q4_K_M
DEFAULT_MODEL_FILE=Gemma-4-E4B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf
MODEL_PATH=models/model.gguf

# The repository also provides an mmproj file (~945 MB) for image/audio
# workflows. This deployment is text-chat first and does not download it.
LLAMA_CTX_SIZE=4096
LLAMA_THREADS=4
LLAMA_BATCH_SIZE=128
LLAMA_PORT=8080

# Gemma 4 recommended sampling values from the model card:
TEMPERATURE=1.0
TOP_P=0.95
TOP_K=64
